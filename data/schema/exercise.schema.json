{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phyoethantnaing.github.io/Hsk-Learning/schema/exercise.schema.json",
  "title": "Workbook exercise (Phase 2)",
  "description": "One exercise in a data/workbooks/hsk{level}/lesson-NN.json file (an array of these).",
  "type": "object",
  "required": ["id", "type", "level", "wordIds", "instruction"],
  "properties": {
    "id": { "type": "string", "pattern": "^hsk([1-6]|7-9)-l[0-9]{2}-ex[0-9]{2}$", "description": "e.g. hsk1-l01-ex03" },
    "type": { "enum": ["multiple-choice", "match", "choose-tone", "fill-blank", "listen-choose"] },
    "level": { "enum": [1, 2, 3, 4, 5, 6, "7-9"] },
    "wordIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^hsk([1-6]|7-9)-[0-9]{4}$" } },
    "instruction": { "type": "string", "description": "What to do, in simple Myanmar" },
    "reviewStatus": { "enum": ["draft", "reviewed"] }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "multiple-choice" } } },
      "then": {
        "required": ["question", "choices", "answer"],
        "properties": {
          "question": { "type": "string" },
          "choices": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "answer": { "type": "integer", "minimum": 0, "description": "Index into choices" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "match" } } },
      "then": {
        "required": ["pairs"],
        "properties": {
          "pairs": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "object", "required": ["left", "right"], "properties": { "left": { "type": "string" }, "right": { "type": "string" } } }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "choose-tone" } } },
      "then": {
        "required": ["syllable", "answer"],
        "properties": {
          "syllable": { "type": "string", "description": "Pinyin without tone mark, e.g. ma" },
          "audio": { "type": ["string", "null"] },
          "answer": { "type": "integer", "minimum": 1, "maximum": 5 }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "fill-blank" } } },
      "then": {
        "required": ["sentence", "choices", "answer"],
        "properties": {
          "sentence": { "type": "string", "description": "Chinese sentence with ＿ for the blank" },
          "pinyin": { "type": "string" },
          "my": { "type": "string" },
          "choices": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "answer": { "type": "integer", "minimum": 0 }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "listen-choose" } } },
      "then": {
        "required": ["text", "choices", "answer"],
        "properties": {
          "text": { "type": "string", "description": "What is spoken (Chinese)" },
          "audio": { "type": ["string", "null"] },
          "choices": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "answer": { "type": "integer", "minimum": 0 }
        }
      }
    }
  ]
}
