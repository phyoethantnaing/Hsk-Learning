---
// One example sentence: Chinese, pinyin, Myanmar. If the sentence uses an
// allowlisted proper noun (缅甸, 仰光 …), its gloss is shown underneath because
// it is not an HSK word the learner has studied.
import { allowlistedIn } from "../lib/allowlist.mjs";
import SpeakButton from "./SpeakButton.astro";

interface Props {
  example: { zh: string; pinyin: string; my: string; audio: string | null };
}

const { example } = Astro.props;
const extras = allowlistedIn(example.zh);
---

<div class="example">
  <p class="zh">
    <span lang="zh-Hans">{example.zh}</span>
    <SpeakButton
      text={example.zh}
      audio={example.audio}
      label="ဥပမာ စာကြောင်းကို နားထောင်ရန်"
    />
  </p>
  <p class="py" lang="zh-Latn-pinyin">
    {example.pinyin}
  </p>
  <p class="my">{example.my}</p>
  {extras.map((e) => (
    <p class="gloss">
      <span lang="zh-Hans">{e.word}</span> ({e.pinyin}) — {e.my}{" "}
      <span class="muted">(HSK စကားလုံး မဟုတ်ပါ)</span>
    </p>
  ))}
</div>

<style>
  .example {
    border-left: 3px solid var(--accent);
    background: var(--surface-2);
    border-radius: 0 16px 16px 0;
    padding: 18px 20px;
    margin: 0 0 18px;
  }

  .example p {
    margin: 0;
  }

  .zh {
    font-size: 1.25rem;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .py {
    color: var(--text-muted);
  }

  .gloss {
    margin-top: 4px !important;
    font-size: 0.875rem;
    background: var(--surface-2);
    border-radius: 8px;
    padding: 2px 8px;
    display: inline-block;
  }
</style>
