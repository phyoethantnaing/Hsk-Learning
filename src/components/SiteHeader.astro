---
import { url } from "../lib/site.mjs";
import { NAV_ITEMS, navigationSection } from "../lib/navigation.mjs";
import Icon from "./Icon.astro";
import Appearance from "./Appearance.astro";
const relative =
  Astro.url.pathname.slice(
    import.meta.env.BASE_URL.replace(/\/$/, "").length,
  ) || "/";
const section = navigationSection(relative);
const exact = (href: string) =>
  relative.replace(/\/$/, "") === href.replace(/\/$/, "");
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={url("/")} aria-label="HSK မြန်မာ — ပင်မ">
      <span class="logo" lang="zh-Hans" aria-hidden="true">
        汉
      </span>
      <span>
        HSK <span class="brand-my">မြန်မာ</span>
      </span>
    </a>
    <nav id="site-nav" class="app-navigation glass" aria-label="အဓိက လမ်းညွှန်">
      <ul>
        {NAV_ITEMS.map((item) => (
          <li>
            <a
              href={url(item.href)}
              data-section={item.key}
              aria-current={
                section === item.key
                  ? exact(item.href)
                    ? "page"
                    : "true"
                  : undefined
              }
            >
              <Icon name={item.icon} size={23} />
              <span>{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="header-actions">
      <a
        class="icon-button about-link"
        href={url("/about/")}
        aria-label="ဆိုက်အကြောင်း"
        aria-current={exact("/about/") ? "page" : undefined}
        title="ဆိုက်အကြောင်း"
      >
        <Icon name="info" size={21} />
      </a>
      <Appearance />
    </div>
  </div>
</header>
<script>
  // The visual viewport shrinks when a software keyboard covers mobile content.
  // Hide only the floating chrome while editing; never suppress browser scrolling.
  const chrome = document.querySelector<HTMLElement>(".site-header")!;
  const navigation = document.querySelector<HTMLElement>("#site-nav")!;
  if ("ResizeObserver" in window) {
    let navHeight = -1;
    let headerHeight = -1;
    const observer = new ResizeObserver(() => {
      // Read both boxes before writing root styles. Avoid redundant invalidation.
      const nextNavHeight = navigation.getBoundingClientRect().height;
      const nextHeaderHeight = chrome.getBoundingClientRect().height;
      if (nextNavHeight !== navHeight) {
        navHeight = nextNavHeight;
        document.documentElement.style.setProperty(
          "--nav-height",
          `${navHeight}px`,
        );
      }
      if (nextHeaderHeight !== headerHeight) {
        headerHeight = nextHeaderHeight;
        document.documentElement.style.setProperty(
          "--header-height",
          `${headerHeight}px`,
        );
      }
    });
    observer.observe(chrome);
    observer.observe(navigation);
  }
  const viewport = window.visualViewport;
  let keyboardOpen = false;
  function updateKeyboard() {
    const editing = document.activeElement?.matches(
      'input:not([type="radio"]), textarea, [contenteditable="true"]',
    );
    const covered = Boolean(
      viewport &&
      viewport.scale === 1 &&
      window.innerHeight - viewport.height > 120,
    );
    // Blur precedes the keyboard's closing animation. Keep tabs out of the
    // reduced viewport until it recovers, so they cannot cover the next tap.
    keyboardOpen = covered && Boolean(editing || keyboardOpen);
    document.documentElement.classList.toggle("keyboard-open", keyboardOpen);
  }
  viewport?.addEventListener("resize", updateKeyboard);
  document.addEventListener("focusin", updateKeyboard);
  document.addEventListener("focusout", () =>
    requestAnimationFrame(updateKeyboard),
  );
  window.addEventListener("pageshow", updateKeyboard);
</script>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
    padding-top: env(safe-area-inset-top);
  }
  .header-inner {
    min-height: 76px;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    text-decoration: none;
    font-weight: 750;
    font-size: 1.1rem;
    line-height: 1.5;
    margin-right: auto;
    min-height: 44px;
    min-width: 0;
  }
  .logo {
    display: grid;
    place-items: center;
    width: 38px;
    height: 40px;
    border-radius: 13px;
    background: linear-gradient(145deg, #d8322e, #b92323);
    color: white;
    font-size: 1.65rem;
    font-weight: 400;
    box-shadow: inset 0 1px 0 #ffffff55;
  }
  .brand-my {
    font-size: 0.92rem;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .app-navigation {
    padding: 5px;
    border-radius: 24px;
  }
  nav ul {
    display: flex;
    list-style: none;
    gap: 4px;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 8px 15px;
    border-radius: 19px;
    text-decoration: none;
    font-size: 0.8rem;
    line-height: 1.8;
    color: var(--text-muted);
    transition:
      background 160ms,
      color 120ms;
  }
  nav a[aria-current] {
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 700;
    box-shadow: inset 0 -1px 0 var(--gold-edge);
  }
  nav a[aria-current] :global(svg) {
    stroke-width: 2.2;
  }
  @media (hover: hover) {
    nav a:hover {
      background: var(--surface-2);
      color: var(--text);
    }
  }
  nav a:active {
    background: var(--accent-soft);
    color: var(--accent);
  }
  @media (max-width: 899px) {
    .header-inner {
      min-height: 64px;
      gap: 12px;
    }
    .app-navigation {
      position: fixed;
      z-index: 20;
      left: max(12px, env(safe-area-inset-left));
      right: max(12px, env(safe-area-inset-right));
      bottom: calc(8px + var(--safe-bottom));
      width: auto;
      max-width: 480px;
      margin-inline: auto;
      border-radius: 30px;
      padding: 6px;
    }
    nav ul {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2px;
    }
    nav a {
      flex-direction: column;
      gap: 3px;
      border-radius: 23px;
      min-width: 0;
      min-height: 58px;
      padding: 6px 3px;
      font-size: 0.68rem;
      line-height: 1.8;
      text-align: center;
    }
    nav a :global(svg) {
      flex: none;
    }
    :global(.keyboard-open) .app-navigation {
      visibility: hidden;
      pointer-events: none;
    }
    :global(html:has(dialog[open])) .app-navigation {
      pointer-events: none;
    }
  }
  @media (max-width: 899px) and (orientation: landscape) and (max-height: 500px) {
    nav a {
      flex-direction: row;
      min-height: 44px;
      gap: 8px;
    }
    .app-navigation {
      border-radius: 26px;
    }
  }
</style>
