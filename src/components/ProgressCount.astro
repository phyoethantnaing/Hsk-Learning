---
// "သိပြီ 12 / 20" with a bar, counted in the browser from saved progress.
interface Props {
  ids: string[];
  label?: string;
}
const { ids, label = "သိပြီ" } = Astro.props;
---

<div class="progress" data-progress-ids={ids.join(",")}>
  <div
    class="progress-bar"
    role="progressbar"
    aria-label={label}
    aria-valuemin="0"
    aria-valuemax={ids.length}
    aria-valuenow="0"
  >
    <span></span>
  </div>
  <p class="progress-text muted">
    {label} <span class="count">0</span> / {ids.length}
  </p>
</div>

<style>
  .progress-text {
    font-size: 0.875rem;
    margin: 4px 0 0;
  }
</style>

<script>
  import { countLearned, onProgress } from "../scripts/progress.js";

  const indicators = [
    ...document.querySelectorAll<HTMLElement>("[data-progress-ids]"),
  ].map((el) => ({
    el,
    ids: el.dataset.progressIds!.split(",").filter(Boolean),
    count: el.querySelector(".count")!,
    bar: el.querySelector(".progress-bar")!,
    fill: el.querySelector<HTMLElement>(".progress-bar > span")!,
    previous: -1,
  }));
  onProgress(() => {
    for (const indicator of indicators) {
      const { el, ids, count, bar, fill } = indicator;
      const done = countLearned(ids);
      if (done === indicator.previous) continue;
      indicator.previous = done;
      count.textContent = String(done);
      bar.setAttribute("aria-valuenow", String(done));
      el.dataset.complete = String(ids.length > 0 && done === ids.length);
      fill.style.transform = `scaleX(${ids.length ? done / ids.length : 0})`;
    }
  });
</script>
