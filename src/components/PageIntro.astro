---
interface Props {
  eyebrow: string;
  title: string;
}
const { eyebrow, title } = Astro.props;
---

<div class="page-intro">
  <p class="eyebrow" lang="en">
    {eyebrow}
  </p>
  <h1>{title}</h1>
  <slot />
</div>
<style>
  .page-intro {
    margin-bottom: 32px;
    max-width: 800px;
  }
  .page-intro :global(p:not(.eyebrow)) {
    color: var(--text-muted);
  }
  .page-intro :global(> :last-child) {
    margin-bottom: 0;
  }
</style>
