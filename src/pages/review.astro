---
// Temporary page for reviewing written word content before the real level and
// word pages exist (step 4). Not linked from the menu and hidden from search engines.
import BaseLayout from '../layouts/BaseLayout.astro';
import Pinyin from '../components/Pinyin.astro';
import ExampleSentence from '../components/ExampleSentence.astro';
import { WORDS } from '../lib/words.mjs';
import { myNumber } from '../lib/site.mjs';

const POS_MY: Record<string, string> = {
  noun: 'နာမ်',
  verb: 'ကြိယာ',
  adjective: 'နာမဝိသေသန',
  adverb: 'ကြိယာဝိသေသန',
  pronoun: 'နာမ်စား',
  numeral: 'ဂဏန်း',
  'measure word': 'ရေတွက်ပုဒ်',
  preposition: 'ဝိဘတ်',
  conjunction: 'သမ္ဗန္ဓ',
  particle: 'ပစ္စည်း',
  interjection: 'အာမေဍိတ်',
  'auxiliary verb': 'ကြိယာထောက်',
  onomatopoeia: 'အသံစွဲ',
  prefix: 'ရှေ့ဆက်',
  suffix: 'နောက်ဆက်',
  phrase: 'စကားစု',
  idiom: 'ဆိုရိုး',
  'proper noun': 'နာမ်ဆိုင်ရာ',
};
const pos = (p: string | string[]) => [p].flat().map((x) => POS_MY[x] ?? x).join('၊ ');

const SECTIONS = [
  ['kidExplanation', '💡', 'ရှင်းပြချက်'],
  ['pronunciationTip', '🗣️', 'အသံထွက်နည်း'],
  ['memoryTip', '🧠', 'မှတ်ရလွယ်အောင်'],
  ['usageNote', '✍️', 'ဘယ်လို သုံးမလဲ'],
  ['commonMistake', '⚠️', 'သတိထားရန်'],
] as const;
---

<BaseLayout title="စစ်ဆေးရန်" noindex>
  <h1>စကားလုံးများ စစ်ဆေးရန်</h1>
  <p class="muted">ရေးပြီးသား စကားလုံး {myNumber(WORDS.length)} လုံး။ ဒီစာမျက်နှာက ယာယီ စစ်ဆေးရန် စာမျက်နှာပါ။</p>

  {
    WORDS.map((w) => (
      <article class="card word" id={w.id}>
        <header>
          <span class="num muted">#{w.id.split('-').at(-1).replace(/^0+/, '')}</span>
          <span class="hanzi" lang="zh-Hans">{w.simplified}</span>
          {w.traditional !== w.simplified && <span class="trad muted" lang="zh-Hant">({w.traditional})</span>}
          {w.reviewStatus === 'draft' && <span class="badge badge-draft">စစ်ဆေးဆဲ</span>}
        </header>
        <p class="py"><Pinyin pinyin={w.pinyin} /></p>
        <p class="meaning">{w.myanmar.meaning}</p>
        <p class="muted small">{pos(w.partOfSpeech)} · {w.english}</p>

        {SECTIONS.filter(([key]) => w.myanmar[key]).map(([key, icon, label]) => (
          <section>
            <h3>{icon} {label}</h3>
            <p>{w.myanmar[key]}</p>
          </section>
        ))}

        <section>
          <h3>📖 ဥပမာ</h3>
          {w.examples.map((ex: any) => <ExampleSentence example={ex} />)}
        </section>

        {w.relatedWords.length > 0 && (
          <section>
            <h3>🔗 ဆက်စပ် စကားလုံးများ</h3>
            <p lang="zh-Hans">{w.relatedWords.join('、')}</p>
          </section>
        )}
      </article>
    ))
  }
</BaseLayout>

<style>
  .word {
    margin-bottom: 20px;
  }

  .word header {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
  }

  .hanzi {
    font-size: 2.5rem;
    line-height: 1.3;
  }

  .py {
    font-size: 1.25rem;
    margin: 0;
  }

  .meaning {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
  }

  .small {
    font-size: 0.875rem;
  }

  section {
    margin-top: 12px;
  }

  h3 {
    margin-bottom: 2px;
  }

  section p {
    margin: 0;
  }
</style>
