---
// Flashcards for one lesson. Front: character. Back: pinyin, meaning, one example.
// "သိတယ်" / "မသိသေးဘူး" answers are saved with src/scripts/progress.js.
import Icon from "../../../../components/Icon.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Pinyin from "../../../../components/Pinyin.astro";
import SpeakButton from "../../../../components/SpeakButton.astro";
import {
  readyLevels,
  lessonsFor,
  lessonUrl,
  wordUrl,
} from "../../../../lib/words.mjs";
import { myNumber } from "../../../../lib/site.mjs";

export function getStaticPaths() {
  return readyLevels().flatMap((level) =>
    lessonsFor(level.key).map((lesson) => ({
      params: { level: level.slug, n: String(lesson.n) },
      props: { level, lesson },
    })),
  );
}

const { level, lesson } = Astro.props;
const title = `${level.label} · သင်ခန်းစာ ${myNumber(lesson.n)} · ကတ်ပြား`;
---

<BaseLayout title={title}>
  <section class="practice-shell" aria-labelledby="practice-title">
    <div class="practice-heading">
      <a class="lesson-back" href={lessonUrl(level.key, lesson.n)}>
        <Icon name="back" size={19} />
        <span>
          {level.label} · သင်ခန်းစာ {myNumber(lesson.n)}
        </span>
      </a>
      <h1 id="practice-title">ကတ်ပြား လေ့ကျင့်ခန်း</h1>
      <p class="practice-help muted">အဖြေကို စဉ်းစားပြီး ကတ်ကို လှန်ပါ။</p>
    </div>
    <div class="deck" data-deck>
      <div class="deck-header">
        <p class="counter muted" aria-live="polite">
          <span data-pos>၁</span> /{" "}
          <span data-total>{myNumber(lesson.words.length)}</span>
        </p>
        <div
          class="deck-progress progress-bar"
          role="progressbar"
          aria-label="ကတ်ပြား တိုးတက်မှု"
          aria-valuemin="0"
          aria-valuemax={lesson.words.length}
          aria-valuenow="0"
          data-deck-progress
        >
          <span></span>
        </div>
      </div>
      {lesson.words.map((w: any) => (
        <div class="flashcard" data-card={w.id} hidden>
          <button
            type="button"
            class="card face front"
            data-flip
            aria-label="အဖြေ ကြည့်ရန် နှိပ်ပါ"
          >
            <span class="hanzi" lang="zh-Hans">
              {w.simplified}
            </span>
            <span class="hint muted">အဖြေ ကြည့်ရန် နှိပ်ပါ</span>
          </button>
          <div class="card face back" tabindex="-1" hidden>
            <p class="hanzi small-hanzi" lang="zh-Hans">
              {w.simplified}
            </p>
            <p class="py">
              <Pinyin pinyin={w.pinyin} />{" "}
              <SpeakButton text={w.simplified} audio={w.audio.word} />
            </p>
            <p class="meaning">{w.myanmar.meaning}</p>
            <p class="example">
              <span lang="zh-Hans">{w.examples[0].zh}</span>
              <br />
              <span class="muted">{w.examples[0].my}</span>
            </p>
            <a class="more" href={wordUrl(w)}>
              အသေးစိတ် ဖတ်ရန် <Icon name="forward" size={16} />
            </a>
          </div>
        </div>
      ))}

      <div class="answer-slot">
        <div class="btn-row answer" data-answer hidden>
          <button type="button" class="btn unknown" data-known="false">
            မသိသေးဘူး
          </button>
          <button type="button" class="btn btn-primary known" data-known="true">
            <Icon name="check" size={20} /> သိတယ်
          </button>
        </div>
      </div>
      <div class="card done" data-done tabindex="-1" hidden>
        <div class="completion-icon">
          <Icon name="check" size={30} />
        </div>
        <h2>ပြီးပါပြီ!</h2>
        <p>
          သိတယ် <strong data-known-count>0</strong> လုံး၊ မသိသေးဘူး{" "}
          <strong data-unknown-count>0</strong> လုံး။
        </p>
        <p class="muted">
          မသိသေးတာ ရှိလည်း စိတ်မပူပါနဲ့ — ပြန်လေ့ကျင့်ရင်း မှတ်မိလာမှာပါ။
        </p>
        <div class="btn-row">
          <button type="button" class="btn btn-primary" data-retry>
            <Icon name="retry" size={20} /> မသိသေးတာတွေ ပြန်လေ့ကျင့်မယ်
          </button>
          <button type="button" class="btn" data-restart>
            အစကနေ ပြန်စမယ်
          </button>
          <a class="btn" href={lessonUrl(level.key, lesson.n)}>
            သင်ခန်းစာကို ပြန်သွားမယ်
          </a>
        </div>
      </div>
    </div>
  </section>
  <noscript>
    <p class="card">
      ကတ်ပြား လေ့ကျင့်ရန် JavaScript ဖွင့်ပေးပါ။{" "}
      <a href={lessonUrl(level.key, lesson.n)}>
        သင်ခန်းစာကို ပြန်သွားမယ် <Icon name="forward" size={18} />
      </a>
    </p>
  </noscript>
</BaseLayout>

<style>
  .deck {
    max-width: 560px;
    perspective: 1200px;
    margin: 16px auto 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .counter {
    text-align: center;
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .practice-shell {
    max-width: 680px;
    margin: 0 auto;
    min-height: calc(100svh - 220px - var(--nav-clearance));
    display: flex;
    flex-direction: column;
  }
  .practice-heading h1 {
    font-size: clamp(1.25rem, 3vw, 1.8rem);
    margin: 6px 0;
  }
  .lesson-back {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 44px;
    font-size: 0.85rem;
    text-decoration: none;
  }
  .practice-help {
    font-size: 0.85rem;
    margin: 0;
  }
  .deck-header {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 14px;
  }
  .counter {
    white-space: nowrap;
    font-size: 0.85rem;
  }
  .deck-progress {
    flex: 1;
  }
  .flashcard {
    flex: 1;
    display: flex;
  }
  .answer-slot {
    min-height: 60px;
  }
  .face {
    width: 100%;
    min-height: 240px;
    flex: 1;
    padding: clamp(24px, 4vw, 40px);
    border-radius: 30px;
    box-shadow: var(--shadow-raised);
    background: var(--surface);
    animation: reveal 260ms var(--ease);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 4px;
  }

  .front {
    font: inherit;
    color: inherit;
    cursor: pointer;
  }

  .front .hanzi {
    font-size: clamp(3.5rem, 16vw, 6.5rem);
    overflow-wrap: anywhere;
    line-height: 1.2;
  }

  .back p {
    margin: 0;
  }

  .small-hanzi {
    font-size: 2.5rem;
  }

  .py {
    font-size: 1.5rem;
    display: flex;
    align-items: center;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .meaning {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .example {
    margin-top: 8px !important;
  }

  .more {
    margin-top: 8px;
    font-size: 0.875rem;
  }

  .answer {
    justify-content: center;
    margin-top: 12px;
  }

  .answer .btn {
    min-width: 0;
    flex: 1;
  }

  @keyframes reveal {
    from {
      opacity: 0.4;
      transform: translateY(8px) rotateX(5deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .completion-icon {
    display: grid;
    place-items: center;
    width: 68px;
    height: 68px;
    border-radius: 50%;
    color: var(--accent);
    background: var(--accent-soft);
    margin: 0 auto 20px;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
  }
  .hint {
    font-size: 0.85rem;
    padding-top: 18px;
  }
  @media (max-width: 899px) {
    .practice-shell {
      min-height: calc(
        100svh - var(--header-height, 64px) - 50px - var(--nav-clearance)
      );
    }
    .face {
      padding: 24px;
    }
  }
  @media (max-height: 700px) {
    .practice-help {
      display: none;
    }
    .face {
      min-height: 180px;
    }
    .front .hanzi {
      font-size: 4rem;
    }
    .practice-heading h1 {
      font-size: 1.25rem;
    }
  }
  .done {
    text-align: center;
  }

  .done .btn-row {
    justify-content: center;
  }
</style>

<script>
  import { recordCard } from "../../../../scripts/progress.js";

  const DIGITS = "၀၁၂၃၄၅၆၇၈၉";
  const my = (n: number) =>
    String(n).replace(/[0-9]/g, (d) => DIGITS[Number(d)]);

  const deck = document.querySelector<HTMLElement>("[data-deck]")!;
  const cards = [...deck.querySelectorAll<HTMLElement>("[data-card]")];
  const answer = deck.querySelector<HTMLElement>("[data-answer]")!;
  const done = deck.querySelector<HTMLElement>("[data-done]")!;
  const pos = deck.querySelector<HTMLElement>("[data-pos]")!;
  const total = deck.querySelector<HTMLElement>("[data-total]")!;

  const progress = deck.querySelector<HTMLElement>("[data-deck-progress]")!;
  let interacted = false;
  let queue: HTMLElement[] = [];
  let index = 0;
  let unknown: HTMLElement[] = [];
  let knownCount = 0;

  function start(list: HTMLElement[]) {
    queue = list;
    index = 0;
    unknown = [];
    knownCount = 0;
    done.hidden = true;
    total.textContent = my(queue.length);
    show();
  }

  function show() {
    document.dispatchEvent(new CustomEvent("learning-card-change"));
    progress.setAttribute("aria-valuemax", String(queue.length));
    progress.setAttribute("aria-valuenow", String(index));
    progress.querySelector<HTMLElement>("span")!.style.width =
      `${queue.length ? (index / queue.length) * 100 : 0}%`;
    for (const c of cards) c.hidden = true;
    const card = queue[index];
    if (!card) {
      answer.hidden = true;
      answer.parentElement!.hidden = true;
      deck.querySelector("[data-known-count]")!.textContent = my(knownCount);
      deck.querySelector("[data-unknown-count]")!.textContent = my(
        unknown.length,
      );
      (deck.querySelector("[data-retry]") as HTMLElement).hidden =
        unknown.length === 0;
      done.hidden = false;
      if (interacted) done.focus({ preventScroll: true });
      return;
    }
    answer.parentElement!.hidden = false;
    card.hidden = false;
    card.querySelector<HTMLElement>(".front")!.hidden = false;
    card.querySelector<HTMLElement>(".back")!.hidden = true;
    answer.hidden = true;
    pos.textContent = my(index + 1);
    if (interacted)
      card.querySelector<HTMLElement>(".front")!.focus({ preventScroll: true });
  }

  deck.addEventListener("click", (e) => {
    interacted = true;
    const t = e.target as HTMLElement;
    if (t.closest("[data-flip]")) {
      const card = queue[index];
      card.querySelector<HTMLElement>(".front")!.hidden = true;
      card.querySelector<HTMLElement>(".back")!.hidden = false;
      answer.hidden = false;
      card.querySelector<HTMLElement>(".back")!.focus({ preventScroll: true });
      const nav = document.querySelector<HTMLElement>("#site-nav")!;
      const bottom =
        getComputedStyle(nav).position === "fixed"
          ? nav.getBoundingClientRect().top
          : window.innerHeight;
      if (answer.getBoundingClientRect().bottom > bottom - 12)
        answer.scrollIntoView({ block: "end", behavior: "auto" });
      return;
    }
    const knownBtn = t.closest<HTMLElement>("[data-known]");
    if (knownBtn) {
      const card = queue[index];
      if (!card || answer.hidden) return;
      const known = knownBtn.dataset.known === "true";
      recordCard(card.dataset.card!, known);
      if (known) knownCount++;
      else unknown.push(card);
      index++;
      show();
      return;
    }
    if (t.closest("[data-retry]")) start(unknown);
    if (t.closest("[data-restart]")) start(cards);
  });

  start(cards);
</script>
