---
// One lesson (e.g. /hsk1/lesson/1/): its ~20 words as cards.
import PageIntro from "../../../../components/PageIntro.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import WordCard from "../../../../components/WordCard.astro";
import ProgressCount from "../../../../components/ProgressCount.astro";
import {
  readyLevels,
  lessonsFor,
  levelUrl,
  lessonUrl,
  flashcardsUrl,
} from "../../../../lib/words.mjs";
import { myNumber, url } from "../../../../lib/site.mjs";

export function getStaticPaths() {
  return readyLevels().flatMap((level) => {
    const lessons = lessonsFor(level.key);
    return lessons.map((lesson) => ({
      params: { level: level.slug, n: String(lesson.n) },
      props: { level, lesson, total: lessons.length },
    }));
  });
}

const { level, lesson, total } = Astro.props;
const title = `${level.label} · သင်ခန်းစာ ${myNumber(lesson.n)}`;
---

<BaseLayout title={title}>
  <p class="breadcrumb">
    <a href={url("/")}>ပင်မ</a> ›{" "}
    <a href={levelUrl(level.key)}>{level.label}</a> › သင်ခန်းစာ{" "}
    {myNumber(lesson.n)}
  </p>
  <PageIntro eyebrow="EXPLORE · LISTEN · LEARN" title={title} />
  <p>
    စကားလုံးကို နှိပ်ပြီး ရှင်းပြချက်၊ အသံထွက်၊ ဥပမာတွေကို ဖတ်ပါ။ ပြီးရင်
    ကတ်ပြားနဲ့ လေ့ကျင့်ပါ။
  </p>
  <ProgressCount ids={lesson.words.map((w: any) => w.id)} />

  <ul class="grid-cards words">
    {lesson.words.map((w: any) => (
      <li>
        <WordCard word={w} />
      </li>
    ))}
  </ul>

  <div class="btn-row actions">
    <a class="btn btn-primary" href={flashcardsUrl(level.key, lesson.n)}>
      ကတ်ပြားနဲ့ လေ့ကျင့်မယ် →
    </a>
  </div>

  <nav class="btn-row pager" aria-label="သင်ခန်းစာများ">
    {lesson.n > 1 && (
      <a class="btn" href={lessonUrl(level.key, lesson.n - 1)}>
        ← သင်ခန်းစာ {myNumber(lesson.n - 1)}
      </a>
    )}
    {lesson.n < total && (
      <a class="btn" href={lessonUrl(level.key, lesson.n + 1)}>
        သင်ခန်းစာ {myNumber(lesson.n + 1)} →
      </a>
    )}
  </nav>
</BaseLayout>

<style>
  .words {
    margin: 28px 0;
  }

  .actions {
    margin: 8px 0 20px;
  }

  .pager {
    justify-content: space-between;
  }
</style>
