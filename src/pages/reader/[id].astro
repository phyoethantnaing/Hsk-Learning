---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PdfReader from "../../components/PdfReader.astro";
import { READABLE_PDFS, pdfTitle } from "../../lib/pdf-library.mjs";
export function getStaticPaths() {
  return READABLE_PDFS.map((doc) => ({
    params: { id: doc.id },
    props: { doc },
  }));
}
const { doc } = Astro.props;
---

<BaseLayout title={pdfTitle(doc)} immersive>
  <PdfReader doc={doc} />
</BaseLayout>
<script>
  import "../../scripts/theme.js";
  import "../../scripts/pdf-reader.js";
</script>
