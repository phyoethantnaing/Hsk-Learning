---
// Client-side search by Chinese, pinyin (with or without tones/numbers), Myanmar or English.
import PageIntro from "../components/PageIntro.astro";
import Icon from "../components/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { url } from "../lib/site.mjs";
---

<BaseLayout title="ရှာရန်">
  <PageIntro eyebrow="FIND YOUR NEXT WORD" title="စကားလုံး ရှာရန်" />
  <form class="search" role="search" action={url("/search/")} method="get">
    <Icon name="search" size={23} />
    <label for="q" class="visually-hidden">
      ရှာမယ့် စကားလုံး
    </label>
    <input
      id="q"
      name="q"
      enterkeyhint="search"
      type="search"
      aria-describedby="search-help"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      placeholder="爱 / ài / ai4 / ချစ် / love"
      data-index={url("/search-index.json")}
      data-base={url("/")}
    />
    <button
      type="button"
      class="icon-button search-clear"
      data-search-clear
      aria-label="ရှာဖွေမှု ရှင်းရန်"
      hidden
    >
      <Icon name="close" size={18} />
    </button>
  </form>
  <p class="muted small" id="search-help">
    တရုတ်စာလုံး၊ pinyin (အသံအမှတ် ပါပါ မပါပါ — ai၊ ài၊ ai4)၊ မြန်မာ အဓိပ္ပာယ်
    ဒါမှမဟုတ် အင်္ဂလိပ်လို ရိုက်ရှာလို့ ရပါတယ်။
  </p>
  <p class="status muted" aria-live="polite" data-status></p>
  <div class="search-empty card" data-search-empty>
    <Icon name="search" size={32} />
    <p>တရုတ်စာလုံး၊ pinyin၊ မြန်မာ သို့မဟုတ် English</p>
    <div class="suggestions">
      <button
        class="btn"
        type="button"
        data-query="你好"
        lang="zh-Hans"
        disabled
        aria-busy="true"
      >
        你好
      </button>
      <button
        class="btn"
        type="button"
        data-query="ai4"
        lang="en"
        disabled
        aria-busy="true"
      >
        ai4
      </button>
      <button
        class="btn"
        type="button"
        data-query="ချစ်"
        disabled
        aria-busy="true"
      >
        ချစ်
      </button>
    </div>
  </div>
  <button class="btn search-retry" type="button" data-search-retry hidden>
    <Icon name="retry" /> ပြန်စမ်းမယ်
  </button>
  <ul class="results" data-results aria-label="ရှာဖွေမှု ရလဒ်များ"></ul>
  <noscript>
    <p class="card">
      ရှာဖွေရန် JavaScript ဖွင့်ပေးပါ။{" "}
      <a href={url("/hsk1/")}>
        HSK 1 စကားလုံးများ <Icon name="forward" size={18} />
      </a>
    </p>
  </noscript>
</BaseLayout>

<style>
  .search-retry {
    margin: 0 0 20px;
  }
  .search-clear {
    flex: none;
    border: 0;
    background: var(--surface-2);
  }
  .search input::-webkit-search-cancel-button {
    display: none;
  }
  .search {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 20px;
    border-radius: 22px;
    margin-bottom: 16px;
    color: var(--text-muted);
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .search:focus-within {
    border-color: var(--accent);
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  .search input {
    width: 100%;
    min-width: 0;
    min-height: 48px;
    padding: 6px 0;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 1rem;
    border-radius: 0;
  }
  .search input:focus {
    outline: none;
  }
  .search-empty {
    text-align: center;
    padding: 54px 20px;
    border-style: dashed;
    box-shadow: none;
    background: transparent;
    color: var(--text-muted);
  }
  .search-empty > svg {
    margin-bottom: 16px;
  }
  .search-empty p {
    font-size: 0.9rem;
  }
  .suggestions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .suggestions .btn {
    min-width: 66px;
    font-weight: 400;
  }
  .status {
    min-height: 30px;
  }

  .small {
    font-size: 0.875rem;
  }

  .results {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
  }

  .results :global(a) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 20px 24px;
    color: var(--text);
    text-decoration: none;
  }

  .results :global(.r-hanzi) {
    font-size: 1.75rem;
    flex-shrink: 0;
    min-width: 3.5rem;
    text-align: center;
  }

  .results :global(.r-text) {
    display: flex;
    flex-direction: column;
    line-height: 1.95;
    min-width: 0;
  }

  .results :global(.r-level) {
    margin-left: auto;
    font-size: 0.8125rem;
    color: var(--text-muted);
    white-space: nowrap;
  }
  @media (max-width: 480px) {
    .results :global(a) {
      padding: 16px 12px;
      gap: 8px;
      flex-wrap: wrap;
    }
    .results :global(.r-text) {
      flex: 1;
      font-size: 0.9rem;
    }
  }
</style>

<script>
  import { normalizeForSearch, toNumbered } from "../lib/pinyin.mjs";

  type Entry = {
    id: string;
    l: string;
    ll: string;
    s: string;
    t: string;
    p: string;
    n: string;
    k: string;
    m: string;
    e: string;
  };

  const input = document.querySelector<HTMLInputElement>("#q")!;
  const results = document.querySelector<HTMLElement>("[data-results]")!;
  const status = document.querySelector<HTMLElement>("[data-status]")!;
  const base = input.dataset.base!.replace(/\/$/, "");
  let index: Entry[] | null = null;
  let pending: Promise<Entry[]> | null = null;
  let request = 0;
  let composing = false;
  let renderedQuery: string | null = null;
  const empty = document.querySelector<HTMLElement>("[data-search-empty]")!;
  const retry = document.querySelector<HTMLButtonElement>(
    "[data-search-retry]",
  )!;
  const clear = document.querySelector<HTMLButtonElement>(
    "[data-search-clear]",
  )!;
  function load(): Promise<Entry[]> {
    if (index) return Promise.resolve(index);
    if (pending) return pending;
    pending = (async () => {
      const response = await fetch(input.dataset.index!);
      if (!response.ok) throw new Error("Search unavailable");
      const data = await response.json();
      if (!Array.isArray(data)) throw new Error("Invalid search data");
      index = data;
      return data;
    })().finally(() => {
      pending = null;
    });
    return pending;
  }

  const HAN = /\p{Script=Han}/u;
  const MYANMAR = /[\u1000-\u109F]/u;

  function score(e: Entry, raw: string): number {
    const q = raw.trim();
    if (HAN.test(q)) {
      if (e.s === q || e.t === q) return 100;
      if (e.s.includes(q) || e.t.includes(q)) return 60 - e.s.length;
      return 0;
    }
    if (MYANMAR.test(q)) {
      const parts = e.m.split("၊").map((x) => x.trim());
      if (parts.includes(q)) return 90;
      return e.m.includes(q) ? 50 : 0;
    }
    const lower = q.toLowerCase();
    const bare = normalizeForSearch(q);
    let s = 0;
    if (bare) {
      // Tone-exact match first: "ai4" or "ài" → "ai4".
      let numbered = "";
      if (/[0-9]|[\u0100-\u01dc]/i.test(q)) {
        try {
          numbered = /[0-9]/.test(q)
            ? lower.replace(/[\s']/g, "").replace(/u:/g, "v").replace(/ü/g, "v")
            : toNumbered(lower).replace(/\s/g, "");
        } catch {
          numbered = "";
        }
      }
      if (numbered && e.n === numbered) s = Math.max(s, 95);
      if (e.k === bare) s = Math.max(s, 80);
      else if (e.k.startsWith(bare)) s = Math.max(s, 55);
    }
    const english = e.e.toLowerCase();
    if (lower.length >= 3) {
      if (
        new RegExp(
          `(^|[;\\s(])(to )?${lower.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}($|[;\\s),])`,
        ).test(english)
      )
        s = Math.max(s, 70);
      else if (english.includes(lower)) s = Math.max(s, 30);
    }
    return s;
  }

  function render(list: Entry[], q: string) {
    renderedQuery = q;
    results.replaceChildren(
      ...list.map((e) => {
        const li = document.createElement("li");
        li.innerHTML = `<a class="card" href="${base}/${e.l}/${e.id}/">
          <span class="r-hanzi" lang="zh-Hans"></span>
          <span class="r-text"><span class="r-py" lang="zh-Latn-pinyin"></span><span class="r-my"></span></span>
          <span class="r-level"></span></a>`;
        li.querySelector(".r-hanzi")!.textContent = e.s;
        li.querySelector(".r-py")!.textContent = e.p;
        li.querySelector(".r-my")!.textContent = e.m;
        li.querySelector(".r-level")!.textContent = e.ll;
        return li;
      }),
    );
    empty.hidden = Boolean(q.trim());
    status.textContent = q
      ? list.length
        ? `${list.length} ခု တွေ့ပါတယ်`
        : "မတွေ့ပါဘူး။ တခြား စကားလုံးနဲ့ ရှာကြည့်ပါ။"
      : "";
  }

  async function search(updateUrl = true) {
    const currentRequest = ++request;
    const q = input.value.trim();
    if (updateUrl) {
      const address = new URL(location.href);
      if (q) address.searchParams.set("q", q);
      else address.searchParams.delete("q");
      history.replaceState(history.state, "", address);
    }
    clear.hidden = !q;
    if (index && renderedQuery === q) return;
    retry.hidden = true;
    if (!q) {
      results.setAttribute("aria-busy", "false");
      render([], "");
      return;
    }
    empty.hidden = true;
    if (!index) {
      results.replaceChildren();
      status.textContent = "ခဏစောင့်ပါ…";
      results.setAttribute("aria-busy", "true");
    }
    try {
      const data = await load();
      if (currentRequest !== request) return;
      const found = data
        .map((e) => ({ e, s: score(e, q) }))
        .filter((x) => x.s > 0)
        .sort((a, b) => b.s - a.s || a.e.id.localeCompare(b.e.id));
      render(
        found.slice(0, 50).map((x) => x.e),
        q,
      );
      if (found.length > 50)
        status.textContent = `${found.length} ခု တွေ့ပါတယ် · ပထမ 50 ခု`;
    } catch {
      if (currentRequest !== request) return;
      results.replaceChildren();
      status.textContent =
        "ရှာဖို့ ဒေတာ မရသေးပါဘူး။ အင်တာနက် ချိတ်ပြီး ပြန်စမ်းကြည့်ပါ။";
      retry.hidden = false;
    } finally {
      if (currentRequest === request)
        results.setAttribute("aria-busy", "false");
    }
  }
  input.addEventListener("compositionstart", () => {
    composing = true;
  });
  input.addEventListener("compositionend", () => {
    composing = false;
    search();
  });
  input.addEventListener("input", () => {
    if (!composing) search();
  });
  input.closest("form")!.addEventListener("submit", (event) => {
    event.preventDefault();
    search();
    input.blur();
  });
  clear.addEventListener("click", () => {
    input.value = "";
    input.focus();
    search();
  });
  retry.addEventListener("click", () => {
    input.focus();
    search();
  });
  for (const chip of document.querySelectorAll<HTMLButtonElement>(
    "[data-query]",
  )) {
    chip.addEventListener("click", () => {
      input.value = chip.dataset.query!;
      input.focus();
      search();
    });
    chip.disabled = false;
    chip.removeAttribute("aria-busy");
  }
  let initialized = false;
  function restore() {
    // Preserve text entered while this module and its Pinyin dependency load.
    if (!initialized && input.value) {
      initialized = true;
      search();
      return;
    }
    initialized = true;
    input.value = new URLSearchParams(location.search).get("q") || "";
    search(false);
  }
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) restore();
  });
  window.addEventListener("popstate", restore);
  restore();
</script>
