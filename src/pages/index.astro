---
import Icon from "../components/Icon.astro";
import SpeakButton from "../components/SpeakButton.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { LEVELS } from "../lib/levels.mjs";
import ProgressCount from "../components/ProgressCount.astro";
import { myNumber, url } from "../lib/site.mjs";
import { readyLevels, wordsForLevel } from "../lib/words.mjs";

// Levels whose content is written get a link and a progress bar; the rest say "soon".
const READY = new Set(readyLevels().map((l) => l.key));
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow" lang="en">
        YOUR CHINESE LEARNING JOURNEY
      </p>
      <p class="hero-zh" lang="zh-Hans">
        你好<span>。</span>
      </p>
      <h1>
        တရုတ်စကားလုံးတွေကို
        <br /> မြန်မာလို လေ့လာပါ
      </h1>
      <p>
        HSK 3.0 (၂၀၂၅) စကားလုံးတွေကို မြန်မာလို ကိုယ်တိုင် လေ့လာပါ။ လက်ရှိ HSK 1
        စကားလုံး {myNumber(wordsForLevel("1").length)} လုံး ရရှိနိုင်ပါတယ်။
        အခမဲ့ပါ။
      </p>
      <p class="btn-row">
        <a
          class="btn btn-primary"
          href={url("/hsk1/")}
          aria-label="HSK 1 စကားလုံးများ လေ့လာမယ်"
        >
          HSK 1 စမယ် <Icon name="arrow" size={18} />
        </a>
        <a class="btn" href={url("/start/")}>
          <Icon name="book" size={18} /> အစပြုရန်
        </a>
      </p>
      <div class="hero-note">
        <span lang="en">HSK 3.0</span>
        <span aria-hidden="true">·</span>
        <span>မြန်မာလို လေ့လာပါ</span>
        <span aria-hidden="true">·</span>
        <span>အခမဲ့</span>
      </div>
    </div>
    <div class="hero-art">
      <div class="orbit orbit-one" aria-hidden="true"></div>
      <div class="orbit orbit-two" aria-hidden="true"></div>
      <div class="sample-card card">
        <div class="sample-top">
          <span class="badge badge-ready" lang="en">
            HSK 1
          </span>
          <span class="muted" lang="en">
            01 / 20
          </span>
        </div>
        <p class="sample-hanzi" lang="zh-Hans">
          你好
        </p>
        <p class="sample-pinyin" lang="zh-Latn-pinyin">
          nǐ hǎo
        </p>
        <p class="sample-meaning">မင်္ဂလာပါ</p>
        <div class="sample-bottom">
          <span class="muted">အသံ နားထောင်ရန်</span>
          <SpeakButton text="你好" />
        </div>
      </div>
      <div class="art-label card">
        <Icon name="book" size={18} />
        <span>တစ်နေ့ စကားလုံး ၅ လုံး</span>
      </div>
      <span class="art-character" lang="zh-Hans" aria-hidden="true">
        学
      </span>
    </div>
  </section>

  <section aria-labelledby="levels-title" class="levels-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow" lang="en">
          ONE STEP AT A TIME
        </p>
        <h2 id="levels-title">အဆင့် ရွေးပါ</h2>
      </div>
      <a class="guide-link" href={url("/start/")}>
        အစပြုသူ လမ်းညွှန် <Icon name="arrow" size={17} />
      </a>
    </div>
    <ul class="levels">
      {LEVELS.map((level) => {
        const ready = READY.has(level.key);
        const Tag = ready ? "a" : "div";
        return (
          <li>
            <Tag
              class:list={["card", "level", { ready }]}
              href={ready ? url(`${level.slug}/`) : undefined}
            >
              <div class="level-top">
                <span class="level-number" lang="en">
                  {level.key.padStart(2, "0")}
                </span>
                {ready ? (
                  <span class="badge badge-ready">လေ့လာနိုင်ပါပြီ</span>
                ) : (
                  <Icon name="lock" size={16} />
                )}
              </div>
              <span class="level-name" lang="en">
                {level.label}
              </span>
              <span class="muted">
                စကားလုံး{" "}
                <span class="nowrap">{myNumber(level.count)} လုံး</span>
              </span>
              {ready ? (
                <ProgressCount
                  ids={wordsForLevel(level.key).map((w) => w.id)}
                />
              ) : (
                <span class="upcoming">
                  <span class="upcoming-line" aria-hidden="true"></span>
                  <span class="badge badge-soon">မကြာခင်</span>
                </span>
              )}
            </Tag>
          </li>
        );
      })}
    </ul>
  </section>

  <section aria-labelledby="how-title" class="how card">
    <p class="eyebrow" lang="en">
      SMALL HABITS. REAL PROGRESS.
    </p>
    <h2 id="how-title">ဘယ်လို လေ့လာမလဲ</h2>
    <ol>
      <li>
        <a href={url("/start/")}>“အစပြုရန်”</a> အပိုင်းမှာ pinyin ဆိုတာ ဘာလဲ၊
        အသံ ၄ မျိုးကို ဘယ်လိုထွက်လဲ အရင် လေ့လာပါ။
      </li>
      <li>
        HSK 1 ကနေ စပါ။ တစ်နေ့ကို စကားလုံး ၅ လုံးလောက် သင်ရင် လုံလောက်ပါပြီ။
      </li>
      <li>
        စကားလုံးတိုင်းမှာ 🔊 ခလုတ်ကို နှိပ်ပြီး အသံကို နားထောင်ပါ။ ပြီးရင်
        ကျယ်ကျယ် လိုက်ပြောပါ။
      </li>
      <li>ကတ်ပြားတွေနဲ့ မနေ့က သင်ထားတာတွေကို ပြန်လေ့ကျင့်ပါ။</li>
    </ol>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: 26px;
    align-items: center;
    padding-bottom: 58px;
  }
  .hero-copy {
    position: relative;
    z-index: 1;
  }
  .hero-zh {
    font-size: clamp(4.5rem, 10vw, 7.25rem);
    font-weight: 650;
    letter-spacing: -0.08em;
    line-height: 1.1;
    margin: 16px 0 28px;
  }
  .hero-zh span {
    color: var(--accent);
  }
  h1 {
    font-size: clamp(1.4rem, 2.35vw, 1.85rem);
    line-height: 1.9;
    letter-spacing: -0.035em;
    margin-bottom: 20px;
  }
  .hero-copy > p:not(.eyebrow, .hero-zh, .btn-row) {
    color: var(--text-muted);
    max-width: 580px;
    font-size: 0.92rem;
  }
  .hero .btn-row {
    margin-top: 27px;
    margin-bottom: 22px;
  }
  .hero-note {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    font-size: 0.7rem;
    color: var(--text-muted);
  }
  .hero-note [lang] {
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .hero-art {
    position: relative;
    min-height: 365px;
    display: grid;
    place-items: center;
    isolation: isolate;
  }
  .hero-art::before {
    content: "";
    position: absolute;
    width: 300px;
    height: 300px;
    max-width: 90%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(229 57 53 / 13%), transparent 70%);
    pointer-events: none;
    z-index: -1;
  }
  .orbit {
    position: absolute;
    width: 65%;
    aspect-ratio: 1;
    max-width: 300px;
    border: 1px solid var(--gold-edge);
    border-radius: 50%;
    pointer-events: none;
    opacity: 0.4;
    z-index: -1;
  }
  .orbit-one {
    transform: rotate(-24deg) scaleX(1.17);
  }
  .orbit-two {
    transform: rotate(35deg) scaleX(1.17);
  }
  .sample-card {
    width: min(265px, 80%);
    padding: 24px;
    transform: rotate(-7deg);
    border-radius: 30px;
    box-shadow: var(--shadow-raised);
    text-align: center;
    z-index: 1;
  }
  .sample-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.65rem;
  }
  .sample-hanzi {
    font-size: 4.4rem;
    line-height: 1.4;
    margin: 22px 0 0;
    font-weight: 500;
  }
  .sample-pinyin {
    color: var(--accent);
    font-size: 1.1rem;
    letter-spacing: 0.06em;
    margin: 0 0 6px;
  }
  .sample-meaning {
    font-size: 0.95rem;
    margin-bottom: 25px;
  }
  .sample-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border);
    padding-top: 14px;
    font-size: 0.7rem;
  }
  .art-label {
    pointer-events: none;
    position: absolute;
    bottom: 5px;
    right: 5%;
    display: flex;
    align-items: center;
    gap: 10px;
    border-radius: 16px;
    padding: 12px 18px;
    font-size: 0.78rem;
    transform: rotate(4deg);
    z-index: 2;
  }
  .art-label svg {
    color: var(--accent);
  }
  .art-character {
    pointer-events: none;
    position: absolute;
    right: 1%;
    top: 6px;
    color: var(--accent);
    color: var(--gold);
    opacity: 0.12;
    font-size: 7rem;
    z-index: -1;
  }
  .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 22px;
    flex-wrap: wrap;
  }
  .section-heading h2 {
    margin: 0;
  }
  .section-heading .eyebrow {
    margin-bottom: 8px;
  }
  .guide-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 44px;
    text-decoration: none;
    font-size: 0.8rem;
  }
  .levels {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .level {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    color: var(--text);
    text-decoration: none;
    padding: 22px;
    border-radius: 22px;
  }
  .level.ready {
    border-color: var(--gold-edge);
  }
  .level:not(.ready) {
    background: transparent;
    box-shadow: none;
  }
  .level-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    min-height: 28px;
    color: var(--text-muted);
  }
  .level-number {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }
  .level-top .badge {
    font-size: 0.65rem;
    padding: 2px 7px;
  }
  .level-name {
    font-size: 1.5rem;
    line-height: 1.5;
    font-weight: 700;
    margin-top: 9px;
  }
  .level > .muted {
    font-size: 0.8rem;
    margin-bottom: 10px;
  }
  .level :global(.progress) {
    margin-top: auto;
  }
  .level :global(.progress-text) {
    font-size: 0.7rem;
  }
  .upcoming {
    margin-top: auto;
  }
  .upcoming-line {
    display: block;
    height: 5px;
    border-radius: 4px;
    background: var(--border);
    margin-bottom: 5px;
    opacity: 0.6;
  }
  .upcoming .badge {
    padding-left: 0;
    background: none;
    font-size: 0.7rem;
  }
  .how {
    margin-top: 48px;
    padding: clamp(24px, 4vw, 40px);
  }
  .how ol {
    list-style: none;
    counter-reset: steps;
    padding: 0;
    display: grid;
    gap: 24px;
    margin: 22px 0 0;
  }
  .how li {
    counter-increment: steps;
    font-size: 0.86rem;
  }
  .how li::before {
    content: "0" counter(steps);
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 9px;
  }
  @media (min-width: 780px) {
    .hero {
      grid-template-columns: 1.3fr 1fr;
      gap: 35px;
      padding-bottom: 76px;
    }
    .hero-art {
      min-height: 440px;
    }
    .sample-card {
      width: 290px;
    }
    .art-label {
      pointer-events: none;
      bottom: 32px;
    }
    .levels {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .how ol {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (max-width: 779px) {
    .hero-art {
      max-width: 420px;
      width: 100%;
      margin: 10px auto 0;
    }
  }
  @media (max-width: 380px) {
    .level {
      padding: 17px 14px;
    }
    .level-top .badge {
      font-size: 0.6rem;
    }
  }
  @media (max-width: 779px) {
    .hero {
      gap: 22px;
      padding-bottom: 38px;
    }
    .hero-zh {
      font-size: 4rem;
      margin: 8px 0 20px;
    }
    h1 {
      font-size: 1.4rem;
      line-height: 1.85;
      margin-bottom: 14px;
    }
    .hero-copy > p:not(.eyebrow, .hero-zh, .btn-row) {
      font-size: 0.9rem;
    }
    .hero .btn-row {
      margin-top: 20px;
      margin-bottom: 14px;
    }
    .hero-art {
      min-height: 0;
      max-width: none;
      margin: 0;
      display: block;
    }
    .sample-card {
      width: 100%;
      transform: none;
      border-radius: 22px;
      text-align: left;
      padding: 16px 20px;
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 0 16px;
      align-items: center;
      box-shadow: none;
    }
    .sample-top {
      grid-column: 1 / -1;
      margin-bottom: 12px;
    }
    .sample-hanzi {
      grid-column: 1;
      grid-row: 2 / 4;
      font-size: 2.6rem;
      margin: 0;
    }
    .sample-pinyin {
      grid-column: 2;
      margin: 0;
      font-size: 0.95rem;
      line-height: 1.5;
    }
    .sample-meaning {
      grid-column: 2;
      margin: 0;
      font-size: 0.8rem;
    }
    .sample-bottom {
      grid-column: 3;
      grid-row: 2 / 4;
      padding: 0;
      border: 0;
    }
    .sample-bottom .muted {
      display: none;
    }
    .orbit,
    .art-label,
    .art-character {
      pointer-events: none;
      display: none;
    }
  }
</style>
