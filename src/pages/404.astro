---
import BaseLayout from "../layouts/BaseLayout.astro";
import { url } from "../lib/site.mjs";
---

<BaseLayout title="စာမျက်နှာ မတွေ့ပါ">
  <section class="card error-state">
    <p class="eyebrow" lang="en">
      404 · A SMALL DETOUR
    </p>
    <p class="error-zh" lang="zh-Hans" aria-hidden="true">
      迷路了？
    </p>
    <h1>ဒီစာမျက်နှာကို ရှာမတွေ့ပါဘူး</h1>
    <p>လင့်ခ် မှားနေတာ ဖြစ်နိုင်ပါတယ်။ စိတ်မပူပါနဲ့။</p>
    <p>
      <a class="btn btn-primary" href={url("/")}>
        ပင်မစာမျက်နှာကို ပြန်သွားရန်
      </a>
    </p>
  </section>
</BaseLayout>
<style>
  .error-state {
    text-align: center;
    max-width: 780px;
    margin: 24px auto;
    padding: 48px 24px;
  }
  .error-state .eyebrow {
    justify-content: center;
  }
  .error-zh {
    font-size: clamp(2.5rem, 8vw, 5rem);
    color: var(--accent);
    margin: 0 0 20px;
  }
</style>
